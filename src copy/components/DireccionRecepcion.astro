---
// src/components/DireccionRecepcion.astro - Recepción Social
---

<section
  class="relative w-full flex justify-center"
  id="rec-wrapper"
  style="padding-top: 0.5rem; padding-bottom: 2.5rem;"
>
  <!-- Flor derecha (contenedor animado por GSAP) -->
  <div
    id="flor-rec"
    class="absolute top-[10%] -translate-y-1/2 -right-8 w-20 sm:w-24 pointer-events-none select-none z-[3]"
  >
    <!-- La imagen mantiene el volteo horizontal fijo -->
    <img
      src="/imagenes/flor2.png"
      alt=""
      class="w-full h-auto"
      style="transform: scaleX(-1);"
    />
  </div>

  <div
    class="relative z-10 w-full max-w-[430px] text-center flex flex-col items-center"
    style="padding-left: 1.5rem; padding-right: 1.5rem;"
  >
    <!-- Icono Recepción (en verde oscuro) -->
    <div
      class="rec-item w-24 h-24 md:w-28 md:h-28 mb-4"
      role="img"
      aria-label="Recepción"
      style="background-color: #3A4A35; -webkit-mask: url('/imagenes/recepcion.png') center / contain no-repeat; mask: url('/imagenes/recepcion.png') center / contain no-repeat;"
    >
    </div>

    <!-- Título -->
    <p
      class="rec-item font-mention italic text-[#3A4A35] text-4xl md:text-5xl"
      style="margin-top: 0.4rem; margin-bottom: 0.6rem;"
    >
      Recepción Social
    </p>

    <!-- Lugar -->
    <p
      class="rec-item font-wiretype text-[#7D9068] text-xl uppercase tracking-[0.04em] mb-5"
    >
      Flia. Rodríguez Orellana
    </p>

    <!-- Dirección -->
    <p
      class="rec-item font-wiretype text-[#7D9068] text-xl tracking-[0.04em] mb-3"
    >
      Zona Plan 3000, B/San Luisito #061
    </p>

    <!-- Referencia -->
    <p
      class="rec-item font-wiretype text-[#7D9068] text-xl uppercase tracking-[0.04em] mb-5"
    >
      9.º anillo, al frente de la parada de la línea 70
    </p>

    <!-- Hora -->
    <p class="rec-item font-wiretype text-[#3A4A35] text-2xl md:text-3xl mb-7">
      HORA: 19:00 p.m.
    </p>

    <!-- Botón -->
    <a
      href="https://maps.app.goo.gl/zH6NSRmmFksGaowy6"
      target="_blank"
      rel="noopener"
      class="rec-item boton-negrita inline-block bg-transparent text-[#3A4A35] border border-[#3A4A35] font-wiretype text-lg tracking-normal uppercase rounded-full shadow-sm transition-all duration-300 hover:bg-[#3A4A35] hover:text-[#EDF0E6] hover:shadow-lg hover:-translate-y-0.5"
      style="padding: 0.7rem 2.25rem; margin-top: 0.75rem;"
    >
      Ver Ubicación
    </a>
  </div>
</section>

<style>
  /* La fuente WireType solo trae un peso, así que font-bold no la engrosa más.
     Engrosamos el trazo para que el botón se vea en negrita. */
  .boton-negrita {
    -webkit-text-stroke: 0.6px currentColor;
    paint-order: stroke fill;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initRecepcion = () => {
    const items = gsap.utils.toArray(".rec-item");
    if (!items.length) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll.
    const reset = () => {
      gsap.killTweensOf([...items, "#flor-rec"]);
      gsap.set(items, { opacity: 0, y: 30 });
      gsap.set("#flor-rec", { opacity: 0, x: 40, y: -20 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#rec-wrapper",
      start: "top 80%",
      onLeaveBack: reset,
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.12,
          ease: "power2.out",
        });
        gsap.to("#flor-rec", {
          opacity: 1,
          x: 0,
          y: 0,
          duration: 1.4,
          ease: "power2.out",
        });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", initRecepcion);
  document.addEventListener("astro:page-load", initRecepcion);
</script>
