---
// src/components/Reservas.astro - Pases asignados (XV años, lila)
interface Props {
    numeroPases: number; // 1, 2, 3, etc.
    nombreInvitado?: string; // Opcional: "Juan Pérez", "Familia García", etc.
}

const { numeroPases = 1, nombreInvitado = "" } = Astro.props;
---

<section
    class="relative w-full flex justify-center overflow-hidden"
    id="pases-wrapper"
    style="padding-top: 1.5rem; padding-bottom: 2.5rem;"
>
    <div
        class="relative z-10 w-full max-w-[430px] text-center flex flex-col items-center"
        style="padding-left: 2rem; padding-right: 2rem;"
    >
        <!-- Frase -->
        <p class="pas-item pas-frase">
            Con mucho cariño hemos reservado para ti
        </p>

        <!-- Nombre del invitado (opcional) -->
        {
            nombreInvitado && (
                <p class="pas-item pas-nombre">{nombreInvitado}</p>
            )
        }

        <!-- Caja con el número y el icono de pases -->
        <div class="pas-item pas-caja">
            <span class="pas-numero">{numeroPases}</span>
            <div
                class="pas-icono"
                role="img"
                aria-label="Pases"
                style="-webkit-mask: url('/iconos/reserva.png') center / contain no-repeat; mask: url('/iconos/reserva.png') center / contain no-repeat;"
            >
            </div>
        </div>

        <!-- Etiqueta -->
        <p class="pas-item pas-label">
            {numeroPases === 1 ? "PASE" : "PASES"}
        </p>
    </div>
</section>

<style>
    /* Frase con la fuente de firma */
    .pas-frase {
        font-family: "Capetown Signature", cursive;
        color: #7b4fa8;
        font-size: clamp(2.5rem, 11vw, 3.2rem);
        line-height: 1.05;
        margin: 0;
        max-width: 340px;
    }

    /* Nombre del invitado */
    .pas-nombre {
        font-family: "Crimson Text", serif;
        color: #8a63b0;
        font-size: clamp(1.1rem, 4.8vw, 1.3rem);
        letter-spacing: 0.08em;
        line-height: 1.3;
        margin: 0;
        margin-top: 0.9rem;
    }

    /* Caja de línea fina */
    .pas-caja {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: clamp(0.6rem, 3vw, 1rem);
        border: 1px solid rgba(123, 79, 168, 0.55);
        padding: 0.9rem 1.4rem;
        margin-top: 1.8rem;
    }

    /* Número de pases */
    .pas-numero {
        font-family: "Crimson Text", serif;
        color: #7b4fa8;
        font-size: clamp(3rem, 14vw, 4rem);
        line-height: 1;
    }

    /* Icono de tickets (coloreado con mask) */
    .pas-icono {
        width: clamp(40px, 12vw, 54px);
        height: clamp(40px, 12vw, 54px);
        background-color: #8a63b0;
    }

    /* PASES */
    .pas-label {
        font-family: "Crimson Text", serif;
        color: #7b4fa8;
        font-size: clamp(1.4rem, 6vw, 1.65rem);
        letter-spacing: 0.25em;
        text-indent: 0.25em;
        line-height: 1.2;
        margin: 0;
        margin-top: 1.1rem;
    }
</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";

    gsap.registerPlugin(ScrollTrigger);

    const initPases = () => {
        const items = gsap.utils.toArray(".pas-item");
        if (!items.length) return;

        // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
        // la animación de entrada se repita en cada scroll.
        const reset = () => {
            gsap.killTweensOf(items);
            gsap.set(items, { opacity: 0, y: 30 });
        };

        reset();

        ScrollTrigger.create({
            trigger: "#pases-wrapper",
            start: "top 80%",
            onLeaveBack: reset,
            onEnter: () => {
                gsap.to(items, {
                    opacity: 1,
                    y: 0,
                    duration: 1,
                    stagger: 0.15,
                    ease: "power2.out",
                });
            },
        });
    };

    document.addEventListener("DOMContentLoaded", initPases);
    document.addEventListener("astro:page-load", initPases);
</script>
