---
// src/components/DireccionCeremonia.astro - Ceremonia (XV años, lila)
const TITULO = "CEREMONIA";
const HORA = "16:00 PM";
const LUGAR = "SALÓN DE EVENTOS MARY";
const UBICACION = "4to anillo del túnel el trompillo a la radial 13";
const MAPA = "https://maps.app.goo.gl/sujtecfy1FdNFr1DA";
---

<section
  class="relative w-full flex justify-center overflow-hidden"
  id="cer-wrapper"
  style="padding-top: 1.5rem; padding-bottom: 2.5rem;"
>
  <!-- Flor lateral izquierda -->
  <div
    id="flor-cer-izq"
    class="absolute left-0 top-0 bottom-0 flex items-center pointer-events-none select-none z-[3]"
    style="width: 15%; max-width: 75px;"
  >
    <img src="/imagenes/lateral.png" alt="" class="w-full h-auto" />
  </div>

  <!-- Flor lateral derecha (la misma, espejada) -->
  <div
    id="flor-cer-der"
    class="absolute right-0 top-0 bottom-0 flex items-center pointer-events-none select-none z-[3]"
    style="width: 15%; max-width: 75px;"
  >
    <img
      src="/imagenes/lateral.png"
      alt=""
      class="w-full h-auto"
      style="transform: scaleX(-1);"
    />
  </div>

  <div
    class="relative z-10 w-full max-w-[430px] text-center flex flex-col items-center"
    style="padding-left: 4rem; padding-right: 4rem;"
  >
    <!-- Icono de la iglesia (coloreado en lila con mask) -->
    <div
      class="cer-item cer-icono"
      role="img"
      aria-label="Fiesta"
      style="-webkit-mask: url('/imagenes/fiesta.png') center / contain no-repeat; mask: url('/imagenes/fiesta.png') center / contain no-repeat;"
    >
    </div>

    <!-- Título -->
    <h3 class="cer-item cer-titulo">{TITULO}</h3>

    <!-- Hora -->
    <p class="cer-item cer-hora">HORA: {HORA}</p>

    <!-- Icono de ubicación -->
    <svg
      class="cer-item cer-pin"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"></path>
      <circle cx="12" cy="10" r="2.6"></circle>
    </svg>

    <!-- Lugar -->
    <p class="cer-item cer-lugar">“{LUGAR}”</p>

    <!-- Ubicación -->
    <p class="cer-item cer-ubicacion">{UBICACION}</p>

    <!-- Botón -->
    <a
      href={MAPA}
      target="_blank"
      rel="noopener"
      class="cer-item cer-boton"
    >
      VER MAPA
    </a>
  </div>
</section>

<style>
  /* Icono superior */
  .cer-icono {
    width: clamp(42px, 12vw, 56px);
    height: clamp(42px, 12vw, 56px);
    background-color: #8a63b0;
  }

  /* Título */
  .cer-titulo {
    font-family: "Crimson Text", serif;
    font-weight: 400;
    color: #7b4fa8;
    font-size: clamp(1.4rem, 6.2vw, 1.8rem);
    letter-spacing: 0.22em;
    text-indent: 0.22em;
    line-height: 1.1;
    margin: 0;
    margin-top: 1.1rem;
  }

  /* Hora */
  .cer-hora {
    font-family: "Crimson Text", serif;
    color: #8a63b0;
    font-size: clamp(1.05rem, 4.6vw, 1.25rem);
    letter-spacing: 0.08em;
    line-height: 1.2;
    margin: 0;
    margin-top: 1.4rem;
  }

  /* Pin de ubicación */
  .cer-pin {
    width: clamp(26px, 7.5vw, 34px);
    height: clamp(26px, 7.5vw, 34px);
    color: #a184c9;
    margin-top: 1.6rem;
  }

  /* Lugar */
  .cer-lugar {
    font-family: "Crimson Text", serif;
    color: #7b4fa8;
    font-size: clamp(1.05rem, 4.6vw, 1.25rem);
    letter-spacing: 0.08em;
    line-height: 1.55;
    margin: 0;
    margin-top: 0.9rem;
  }

  /* Ubicación (dirección) */
  .cer-ubicacion {
    font-family: "Crimson Text", serif;
    color: #8a63b0;
    font-size: clamp(1.25rem, 5.2vw, 1.4rem);
    letter-spacing: 0.03em;
    line-height: 1.45;
    margin: 0;
    margin-top: 0.6rem;
    max-width: 300px;
  }

  /* Botón */
  .cer-boton {
    display: inline-block;
    font-family: "Crimson Text", serif;
    font-size: clamp(0.9rem, 3.8vw, 1.05rem);
    letter-spacing: 0.16em;
    color: #ffffff;
    background: #9b78c4;
    border-radius: 6px;
    padding: 0.65rem 1.9rem;
    margin-top: 1.6rem;
    box-shadow: 0 6px 14px rgba(110, 75, 150, 0.25);
    transition: all 0.3s ease;
  }

  .cer-boton:hover {
    background: #7b4fa8;
    box-shadow: 0 10px 20px rgba(110, 75, 150, 0.35);
    transform: translateY(-2px);
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initCeremonia = () => {
    const items = gsap.utils.toArray(".cer-item");
    if (!items.length) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll.
    const reset = () => {
      gsap.killTweensOf([...items, "#flor-cer-izq", "#flor-cer-der"]);
      gsap.set(items, { opacity: 0, y: 30 });
      gsap.set("#flor-cer-izq", { opacity: 0, x: -40 });
      gsap.set("#flor-cer-der", { opacity: 0, x: 40 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#cer-wrapper",
      start: "top 80%",
      onLeaveBack: reset,
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.12,
          ease: "power2.out",
        });
        gsap.to(["#flor-cer-izq", "#flor-cer-der"], {
          opacity: 1,
          x: 0,
          duration: 1.4,
          ease: "power2.out",
        });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", initCeremonia);
  document.addEventListener("astro:page-load", initCeremonia);
</script>
