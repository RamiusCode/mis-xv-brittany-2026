---
// src/components/NombresPadres.astro - Mi madre (XV años, lila + dorado)
const MADRE = "Gabriela";
---

<section
  class="relative w-full flex justify-center overflow-hidden"
  id="np-wrapper"
  style="padding-top: 1rem; padding-bottom: 1rem;"
>
  <!-- Flor lateral izquierda -->
  <div
    id="flor-izq"
    class="absolute left-0 top-0 bottom-0 flex items-center pointer-events-none select-none z-[3]"
    style="width: 13%; max-width: 65px;"
  >
    <img src="/imagenes/lateral.png" alt="" class="w-full h-auto" />
  </div>

  <!-- Flor lateral derecha (la misma, espejada) -->
  <div
    id="flor-der"
    class="absolute right-0 top-0 bottom-0 flex items-center pointer-events-none select-none z-[3]"
    style="width: 13%; max-width: 65px;"
  >
    <img
      src="/imagenes/lateral.png"
      alt=""
      class="w-full h-auto"
      style="transform: scaleX(-1);"
    />
  </div>

  <div
    class="relative z-10 w-full max-w-[480px] text-center flex flex-col items-center"
    style="padding-left: 2rem; padding-right: 2rem;"
  >
    <!-- Adorno dorado -->
    <div class="np-item np-adorno">
      <span class="np-adorno-linea"></span>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path
          d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        ></path>
      </svg>
      <span class="np-adorno-linea"></span>
    </div>

    <!-- MI MADRE -->
    <h3 class="np-item np-titulo">MI MADRE</h3>

    <!-- Nombre -->
    <h2 class="np-item np-nombre">{MADRE}</h2>

    <!-- Agradecimiento -->
    <p class="np-item np-texto">
      A ella agradezco todo<br />lo que soy hoy
    </p>
  </div>
</section>

<style>
  /* Adorno dorado (acento) */
  .np-adorno {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #c4945c;
    margin-bottom: 1.1rem;
  }

  .np-adorno svg {
    width: clamp(13px, 3.6vw, 18px);
    height: clamp(13px, 3.6vw, 18px);
  }

  .np-adorno-linea {
    display: block;
    width: clamp(24px, 9vw, 40px);
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(196, 148, 92, 0),
      #c4945c,
      rgba(196, 148, 92, 0)
    );
  }

  /* MI MADRE */
  .np-titulo {
    font-family: "Crimson Text", serif;
    font-weight: 400;
    color: #8a63b0;
    font-size: clamp(1.1rem, 5vw, 1.4rem);
    letter-spacing: 0.28em;
    text-indent: 0.28em;
    line-height: 1;
    margin: 0;
  }

  /* Nombre en el degradado lila de la portada */
  .np-nombre {
    font-family: "Great Vibes", cursive;
    font-size: clamp(2.9rem, 15vw, 4.4rem);
    line-height: 1.35;
    margin: 0;
    margin-top: 1.2rem;
    /* El degradado se recorta con background-clip: text, así que la caja
       necesita aire extra o los rasgos de la cursiva salen y se "cortan". */
    padding: 0.12em 0.15em 0.25em;
    white-space: nowrap;
    background: linear-gradient(
      100deg,
      #c9b3e2 0%,
      #a184c9 22%,
      #7b4fa8 45%,
      #a98cc9 62%,
      #7b4fa8 82%,
      #cbb8e4 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 4px rgba(110, 75, 150, 0.18));
  }

  /* Agradecimiento */
  .np-texto {
    font-family: "Crimson Text", serif;
    color: #7f5aa8;
    font-size: clamp(1.25rem, 5.4vw, 1.5rem);
    line-height: 1.45;
    margin: 0;
    margin-top: 1.4rem;
    max-width: 330px;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initPadres = () => {
    const items = gsap.utils.toArray(".np-item");
    if (!items.length) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll.
    const reset = () => {
      gsap.killTweensOf([...items, "#flor-izq", "#flor-der"]);
      gsap.set(items, { opacity: 0, y: 30 });
      gsap.set("#flor-izq", { opacity: 0, x: -40 });
      gsap.set("#flor-der", { opacity: 0, x: 40 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#np-wrapper",
      start: "top 80%",
      onLeaveBack: reset,
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.12,
          ease: "power2.out",
        });
        gsap.to(["#flor-izq", "#flor-der"], {
          opacity: 1,
          x: 0,
          duration: 1.4,
          ease: "power2.out",
        });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", initPadres);
  document.addEventListener("astro:page-load", initPadres);
</script>
