---
// Compartirfotos.astro - Comparte tus fotos
// Enlace del álbum compartido (Google Drive)
const ENLACE_ALBUM =
  "https://drive.google.com/drive/folders/1z8wy75Zu7OUrtVRTGV-UHYZYqg1Zdmea";
---

<section
  class="relative w-full overflow-x-clip flex justify-center"
  id="cf-wrapper"
  style="padding-top: 1rem; padding-bottom: 1rem; margin-top: 0.5rem; margin-bottom: 0.5rem;"
>
  <!-- Flor inferior izquierda (flor2) -->
  <div
    id="cf-flor"
    class="absolute -top-2 -left-5 w-16 sm:w-20 pointer-events-none select-none z-[2] opacity-90"
  >
    <img src="/imagenes/flor2.png" alt="" class="w-full h-auto" />
  </div>

  <div
    class="relative z-10 w-full max-w-[430px] text-center flex flex-col items-center"
    style="padding-left: 1.75rem; padding-right: 1.75rem;"
  >
    <!-- Icono cámara (foto.png) -->
    <div
      class="cf-item w-24 h-24 md:w-28 md:h-28"
      role="img"
      aria-label="Cámara"
      style="background-color:#3A4A35; -webkit-mask:url('/iconos/foto.png') center / contain no-repeat; mask:url('/iconos/foto.png') center / contain no-repeat; margin-bottom: 0.75rem;"
    >
    </div>

    <!-- Título -->
    <p
      class="cf-item font-mention italic text-[#3A4A35] text-4xl md:text-5xl"
      style="margin-bottom: 1.25rem;"
    >
      ¡Captura el mejor momento!
    </p>

    <!-- Texto -->
    <p
      class="cf-item font-wiretype text-[#7D9068] text-xl leading-relaxed"
      style="margin-bottom: 1.75rem; padding-left: 0.75rem; padding-right: 0.75rem;"
    >
      Ayúdanos a guardar cada instante de este día especial. ¡Sube tus mejores
      fotos y videos a nuestro álbum compartido!
    </p>

    <!-- Botón -->
    <a
      href={ENLACE_ALBUM}
      target="_blank"
      rel="noopener"
      class="cf-item boton-negrita inline-block bg-transparent text-[#3A4A35] border border-[#3A4A35] font-wiretype text-lg tracking-normal uppercase rounded-full shadow-sm transition-all duration-300 hover:bg-[#3A4A35] hover:text-[#EDF0E6] hover:shadow-lg hover:-translate-y-0.5"
      style="padding: 0.7rem 2.25rem; margin-top: 0.25rem;"
    >
      Subir Fotos
    </a>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initCompartir = () => {
    const items = gsap.utils.toArray(".cf-item");
    if (!items.length) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll.
    const reset = () => {
      gsap.killTweensOf([...items, "#cf-flor"]);
      gsap.set(items, { opacity: 0, y: 30 });
      gsap.set("#cf-flor", { opacity: 0, x: -40, y: 20 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#cf-wrapper",
      start: "top 80%",
      onLeaveBack: reset,
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.12,
          ease: "power2.out",
        });
        gsap.to("#cf-flor", {
          opacity: 0.9,
          x: 0,
          y: 0,
          duration: 1.4,
          ease: "power2.out",
        });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", initCompartir);
  document.addEventListener("astro:page-load", initCompartir);
</script>

<style>
  /* La fuente WireType solo trae un peso, así que font-bold no la engrosa más.
     Engrosamos el trazo para que el botón se vea en negrita. */
  .boton-negrita {
    -webkit-text-stroke: 0.6px currentColor;
    paint-order: stroke fill;
  }
</style>
