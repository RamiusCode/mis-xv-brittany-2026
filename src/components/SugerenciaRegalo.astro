---
// src/components/SugerenciaRegalo.astro - Sugerencia de Regalos
---

<section
  class="relative w-full flex justify-center overflow-hidden"
  id="reg-wrapper"
  style="padding-top: 1.5rem; padding-bottom: 2.5rem;"
>
  <!-- Flor derecha (volteada horizontalmente) -->
  <div
    class="absolute top-[18%] -translate-y-1/2 -right-3 z-[3] pointer-events-none"
    style="transform: scaleX(-1);"
  >
    <img
      src="/imagenes/flor2.png"
      alt=""
      id="reg-flor"
      class="w-16 sm:w-20 select-none"
    />
  </div>

  <div
    class="relative z-10 w-full max-w-[430px] text-center flex flex-col items-center"
    style="padding-left: 1.5rem; padding-right: 1.5rem;"
  >
    <!-- Título -->
    <p
      class="reg-item font-mention italic text-[#3A4A35] text-4xl md:text-5xl mb-4"
    >
      Sugerencia de Regalos
    </p>

    <!-- Icono regalo (coloreado en naranja) -->
    <div
      class="reg-item w-12 h-12 md:w-14 md:h-14"
      role="img"
      aria-label="Regalo"
      style="margin-top: 1.25rem; margin-bottom: 1.75rem; background-color: #3A4A35; -webkit-mask: url('/imagenes/regalo.png') center / contain no-repeat; mask: url('/imagenes/regalo.png') center / contain no-repeat;"
    >
    </div>

    <!-- Texto -->
    <p
      class="reg-item font-wiretype text-[#7D9068] text-lg md:text-lg leading-relaxed max-w-[340px] mb-8"
    >
      Su presencia es lo más importante para nosotros. Pero si desean
      hacernos llegar un detalle, pueden hacerlo mediante el siguiente QR.
    </p>

    <!-- QR -->
    <img
      src="/imagenes/qr.png"
      alt="Código QR de regalo"
      class="reg-item w-52 sm:w-60 h-auto"
      style="margin-top: 0.5rem; margin-bottom: 1.5rem;"
    />

    <!-- Nombre de cuenta -->
    <!-- PENDIENTE: datos.txt no indica titular de cuenta. Descomentar y completar cuando lo proporcionen.
    <p class="reg-item font-wiretype text-[#7D9068] text-lg md:text-base">
      Nombre de cuenta:<br /> NOMBRE DEL TITULAR
    </p>
    -->
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initRegalo = () => {
    const items = gsap.utils.toArray(".reg-item");
    if (!items.length) return;

    gsap.set(items, { opacity: 0, y: 30 });
    gsap.set("#reg-flor", { opacity: 0, x: 40, y: -20 });

    ScrollTrigger.create({
      trigger: "#reg-wrapper",
      start: "top 80%",
      once: true,
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.15,
          ease: "power2.out",
        });
        gsap.to("#reg-flor", {
          opacity: 1,
          x: 0,
          y: 0,
          duration: 1.4,
          ease: "power2.out",
        });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", initRegalo);
  document.addEventListener("astro:page-load", initRegalo);
</script>
