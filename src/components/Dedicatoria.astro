---
// src/components/Dedicatoria.astro - Cita bíblica (Mateo 19:6)
---

<section
  class="relative w-full flex justify-center overflow-x-clip"
  id="ded-wrapper"
  style="padding-top: 0.5rem; padding-bottom: 0.5rem;"
>
  <!-- Flor lateral derecha (la rama apunta a la derecha, va sin voltear) -->
  <img
    src="/imagenes/florcosatado.png"
    alt=""
    id="flor-ded"
    class="absolute -top-8 right-0 w-28 sm:w-32 pointer-events-none select-none z-[3]"
  />

  <div
    class="relative z-10 w-full max-w-[480px] text-center flex flex-col items-center"
    style="padding-left: 2.75rem; padding-right: 2.75rem;"
  >
    <p
      class="ded-item font-wiretype text-[#7D9068] text-xl leading-relaxed"
      style="max-width: 16em; text-wrap: balance;"
    >
      Dios ha sido bueno y ha guiado nuestro amor. Con alegría en el corazón,
      te invitamos a acompañarnos en el día en que sellaremos este pacto con
      Él...
    </p>
  </div>
</section>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initDedicatoria = () => {
    const items = gsap.utils.toArray(".ded-item");
    if (!items.length) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll. El killTweensOf
    // evita que el balanceo en bucle de la flor se acumule al repetirse.
    const reset = () => {
      gsap.killTweensOf([...items, "#flor-ded"]);
      gsap.set(items, { opacity: 0, y: 30 });
      gsap.set("#flor-ded", { opacity: 0, x: 40, y: -20, rotation: 0 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#ded-wrapper",
      start: "top 80%",
      onLeaveBack: reset,
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.2,
          ease: "power2.out",
        });
        gsap.to("#flor-ded", {
          opacity: 1,
          x: 0,
          y: 0,
          duration: 1.4,
          ease: "power2.out",
          onComplete: () => {
            gsap.to("#flor-ded", {
              y: 8,
              rotation: -2,
              duration: 5,
              repeat: -1,
              yoyo: true,
              ease: "sine.inOut",
            });
          },
        });
      },
    });
  };

  document.addEventListener("DOMContentLoaded", initDedicatoria);
  document.addEventListener("astro:page-load", initDedicatoria);
</script>
