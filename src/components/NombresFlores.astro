---
// src/components/NombresFlores.astro - Nombre + reproductor (XV años, lila + dorado)
const NOMBRE = "Brittany";
---

<section
  class="relative w-full flex justify-center overflow-hidden"
  id="nf-wrapper"
>
  <div class="relative w-full max-w-[480px]">
    <!-- Flor superior derecha (misma flor de la portada, espejada) -->
    <div
      id="flores-arriba"
      class="absolute -top-2 right-0 pointer-events-none select-none z-[3] nf-anim nf-flores"
      style="width: 62%; max-width: 300px;"
    >
      <img
        src="/imagenes/flor.png"
        alt=""
        class="w-full h-auto"
        style="transform: scaleX(-1);"
      />
    </div>

    <!-- Contenido principal (arriba, debajo de las flores) -->
    <div
      class="relative z-[10] text-center px-6 flex flex-col items-center"
      style="padding-top: 30%; padding-bottom: 2rem;"
    >
      <!-- MIS -->
      <p class="nf-mis nf-anim nf-titulo">MIS</p>

      <!-- 15 años -->
      <h1 class="nf-quince nf-anim nf-nombre1">15 años</h1>

      <!-- Adorno dorado (acento) -->
      <div class="nf-adorno nf-anim nf-amp">
        <span class="nf-adorno-linea"></span>
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
          ></path>
        </svg>
        <span class="nf-adorno-linea"></span>
      </div>

      <!-- Nombre -->
      <h2 class="nf-nombre nf-anim nf-nombre2">{NOMBRE}</h2>

      <!-- Foto de la quinceañera: medallón ovalado con doble anillo dorado -->
      <div class="nf-foto-wrap nf-anim nf-foto-in">
        <span class="nf-resplandor"></span>
        <span class="nf-foto-anillo-ext"></span>
        <span class="nf-foto-anillo-int"></span>

        <div class="nf-foto-ovalo">
          <img
            src="/imagenes/foto1.png"
            alt={`Foto de ${NOMBRE}`}
            class="nf-foto"
          />
          <span class="nf-foto-vineta"></span>
          <span class="nf-foto-brillo"></span>
        </div>

        <span class="nf-foto-joya nf-joya-arriba"></span>
        <span class="nf-foto-joya nf-joya-abajo"></span>

        <!-- Guirnaldas a los costados, a la altura de la foto (volteadas
             en vertical y espejadas entre sí) -->
        <img
          src="/imagenes/separador.png"
          alt=""
          class="nf-foto-guirnalda nf-guirnalda-izq"
        />
        <img
          src="/imagenes/separador.png"
          alt=""
          class="nf-foto-guirnalda nf-guirnalda-der"
        />
      </div>

      <!-- REPRODUCTOR DE MUSICA -->
      <div
        class="w-full flex flex-col items-center nf-anim nf-player"
        style="margin-top: 2.5rem;"
      >
        <!-- Texto -->
        <p class="nf-texto-player">
          Dale play para escuchar la canción
        </p>

        <!-- Barra de progreso -->
        <div
          id="barra-progreso"
          class="relative h-[3px] bg-[#8A63B0]/25 rounded-full w-full"
          style="max-width: 220px; margin-top: 1.75rem; margin-bottom: 1.25rem;"
        >
          <div
            id="progreso-fill"
            class="absolute left-0 top-0 h-full bg-[#7B4FA8] rounded-full"
            style="width: 0%;"
          >
          </div>
          <div
            id="progreso-dot"
            class="absolute top-1/2 w-3 h-3 bg-[#C4945C] rounded-full shadow -translate-y-1/2 -translate-x-1/2"
            style="left: 0%;"
          >
          </div>
        </div>

        <!-- Controles -->
        <div
          class="flex items-center justify-between w-full"
          style="max-width: 220px;"
        >
          <!-- Shuffle -->
          <svg
            class="w-4 h-4 text-[#8A63B0]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M16 3h5v5M4 20 21 3M21 16v5h-5M15 15l6 6M4 4l5 5"></path>
          </svg>

          <!-- Anterior -->
          <svg
            id="btn-prev"
            class="w-5 h-5 text-[#8A63B0] cursor-pointer"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M6 6h2v12H6z M20 6v12l-9-6z"></path>
          </svg>

          <!-- Play/Pausa (lila con anillo dorado) -->
          <button
            id="btn-play-corazon"
            class="nf-btn-play w-14 h-14 rounded-full flex items-center justify-center transition-transform duration-200 hover:scale-110 active:scale-95"
            aria-label="Reproducir canción"
          >
            <!-- Play (triángulo) - visible cuando está pausada -->
            <svg
              id="corazon-play"
              class="w-7 h-7 text-white"
              viewBox="0 0 24 24"
              fill="currentColor"
              style="margin-left: 2px;"
            >
              <path d="M8 5v14l11-7z"></path>
            </svg>
            <!-- Pausa - visible cuando está sonando -->
            <svg
              id="corazon-pause"
              class="w-7 h-7 text-white hidden"
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="M6 5h4v14H6z M14 5h4v14h-4z"></path>
            </svg>
          </button>

          <!-- Siguiente -->
          <svg
            id="btn-next"
            class="w-5 h-5 text-[#8A63B0] cursor-pointer"
            viewBox="0 0 24 24"
            fill="currentColor"
          >
            <path d="M16 6h2v12h-2z M4 6l9 6-9 6z"></path>
          </svg>

          <!-- Repetir -->
          <svg
            class="w-4 h-4 text-[#8A63B0]"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M17 2l4 4-4 4M3 11V9a4 4 0 0 1 4-4h14M7 22l-4-4 4-4M21 13v2a4 4 0 0 1-4 4H3"
            ></path>
          </svg>
        </div>
      </div>
    </div>
  </div>

</section>

<style>
  /* TIPOGRAFIAS Y COLORES (lila + dorado de acento) */
  .nf-mis {
    font-family: "Crimson Text", serif;
    color: #8a63b0;
    font-size: clamp(1.3rem, 6.4vw, 1.9rem);
    letter-spacing: 0.38em;
    text-indent: 0.38em;
    line-height: 1;
    margin: 0;
  }

  /* Degradado lila compartido por "15 años" y el nombre
     (el mismo de la portada, para que se sientan una sola pieza) */
  .nf-quince,
  .nf-nombre {
    font-family: "Great Vibes", cursive;
    line-height: 1.3;
    margin: 0;
    /* El degradado se recorta con background-clip: text, así que la caja
       necesita aire extra o los rasgos de la cursiva salen y se "cortan". */
    padding: 0.12em 0.15em 0.25em;
    white-space: nowrap;
    background: linear-gradient(
      100deg,
      #c9b3e2 0%,
      #a184c9 22%,
      #7b4fa8 45%,
      #a98cc9 62%,
      #7b4fa8 82%,
      #cbb8e4 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 2px 4px rgba(110, 75, 150, 0.18));
  }

  .nf-quince {
    font-size: clamp(3.4rem, 19vw, 5.6rem);
    margin-top: clamp(0.6rem, 2vw, 1.1rem);
  }

  .nf-nombre {
    font-size: clamp(2.7rem, 15vw, 4.4rem);
    margin-top: 0.2rem;
  }

  /* Corazón dorado entre el título y el nombre, con líneas al costado */
  .nf-adorno {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    color: #c4945c;
    margin-top: 0.35rem;
  }

  .nf-adorno svg {
    width: clamp(13px, 3.6vw, 18px);
    height: clamp(13px, 3.6vw, 18px);
  }

  .nf-adorno-linea {
    display: block;
    width: clamp(24px, 9vw, 40px);
    height: 1px;
    background: linear-gradient(
      to right,
      rgba(196, 148, 92, 0),
      #c4945c,
      rgba(196, 148, 92, 0)
    );
  }

  /* ── Foto de la quinceañera ──────────────────────
     Arco con marco dorado, borde inferior desvanecido hacia el fondo,
     zoom lentísimo permanente y un brillo que cruza una sola vez. */
  .nf-foto-wrap {
    position: relative;
    width: 62%;
    max-width: 260px;
    margin-top: 2.4rem;
    margin-bottom: 0.6rem;
  }

  /* Resplandor suave detrás del medallón */
  .nf-resplandor {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 250%;
    aspect-ratio: 1;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.85) 0%,
      rgba(236, 226, 249, 0.55) 32%,
      rgba(196, 148, 92, 0.16) 52%,
      transparent 70%
    );
    opacity: 0;
    pointer-events: none;
    z-index: 0;
  }

  /* Doble anillo dorado concéntrico, siguiendo el óvalo */
  .nf-foto-anillo-ext,
  .nf-foto-anillo-int {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .nf-foto-anillo-ext {
    inset: -15px;
    border: 1.5px solid rgba(196, 148, 92, 0.85);
    box-shadow: 0 0 22px rgba(196, 148, 92, 0.25);
  }

  .nf-foto-anillo-int {
    inset: -6px;
    border: 1px solid rgba(196, 148, 92, 0.4);
    /* La sombra del medallón vive acá, en un elemento elíptico y SIN
       clip-path: si va en el óvalo, el clip-path del reveal la recorta en
       rectángulo y deja un bloque oscuro con borde recto debajo. */
    box-shadow: 0 16px 30px rgba(110, 75, 150, 0.26);
  }

  /* Joyas romboidales arriba y abajo del medallón */
  .nf-foto-joya {
    position: absolute;
    left: 50%;
    width: 10px;
    height: 10px;
    background: linear-gradient(140deg, #e8cf9a, #c4945c);
    box-shadow:
      0 0 0 3px rgba(255, 255, 255, 0.9),
      0 0 14px rgba(196, 148, 92, 0.6);
    z-index: 2;
  }

  .nf-joya-arriba {
    top: -20px;
    transform: translateX(-50%) rotate(45deg);
  }

  .nf-joya-abajo {
    bottom: -20px;
    transform: translateX(-50%) rotate(45deg);
  }

  /* Guirnaldas laterales: se anclan al contenedor de la foto, así quedan
     siempre a su altura. Se giran 90° para que corran en VERTICAL a los
     costados. El width es el largo de la guirnalda (tras el giro pasa a
     ser su altura); el desplazamiento -70% deja su centro a -20% del
     marco, o sea afuera del medallón, sin taparlo. */
  .nf-foto-guirnalda {
    position: absolute;
    top: 50%;
    width: 100%;
    height: auto;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .nf-guirnalda-izq {
    left: -70%;
    transform: translateY(-50%) rotate(90deg);
  }

  .nf-guirnalda-der {
    right: -70%;
    transform: translateY(-50%) rotate(-90deg);
  }

  /* Óvalo con la foto */
  .nf-foto-ovalo {
    position: relative;
    z-index: 1;
    aspect-ratio: 3 / 4;
    border-radius: 50%;
    overflow: hidden;
  }

  /* Viñeta interior: oscurece apenas el borde del óvalo y da profundidad */
  .nf-foto-vineta {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 40px 6px rgba(90, 55, 130, 0.28);
    pointer-events: none;
  }

  .nf-foto {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Encuadre: mantiene la cara visible al recortar en vertical */
    object-position: 56% 22%;
    user-select: none;
  }

  /* Destello diagonal */
  .nf-foto-brillo {
    position: absolute;
    top: -25%;
    left: -60%;
    width: 45%;
    height: 150%;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(255, 255, 255, 0.55) 50%,
      transparent 100%
    );
    transform: skewX(-18deg);
    opacity: 0;
    pointer-events: none;
  }

  /* Texto del reproductor */
  .nf-texto-player {
    font-family: "Crimson Text", serif;
    color: #7f5aa8;
    font-size: clamp(1rem, 4.4vw, 1.15rem);
    line-height: 1.6;
    max-width: 240px;
    margin: 0;
  }

  /* Botón de play: lila con anillo dorado */
  .nf-btn-play {
    background: linear-gradient(145deg, #9b78c4, #7b4fa8);
    box-shadow:
      0 0 0 2px #c4945c,
      0 8px 18px rgba(110, 75, 150, 0.35);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      filter: blur(4px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes scale-in {
    from {
      transform: scale(0) rotate(-20deg);
      opacity: 0;
      filter: blur(8px);
    }
    to {
      transform: scale(1) rotate(0deg);
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes slide-down {
    from {
      transform: translateY(-40px);
      opacity: 0;
      filter: blur(8px);
    }
    to {
      transform: translateY(0);
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes slide-up {
    from {
      transform: translateY(60px) scale(0.9);
      opacity: 0;
      filter: blur(10px);
    }
    to {
      transform: translateY(0) scale(1);
      opacity: 1;
      filter: blur(0);
    }
  }

  /* Animación de entrada: los elementos arrancan ocultos y solo se animan
     cuando la sección entra en pantalla (clase .animar que pone el script).
     Al salir hacia arriba se quita la clase y la entrada se repite en el
     siguiente scroll. */
  #nf-wrapper .nf-anim {
    opacity: 0;
  }

  #nf-wrapper.animar .nf-flores {
    animation: slide-down 1.5s ease-out both;
  }

  /* "MIS": solo entra con slide-down (sin latido). */
  #nf-wrapper.animar .nf-titulo {
    transform-origin: center;
    animation: slide-down 1.5s ease-out 0.2s both;
  }

  #nf-wrapper.animar .nf-nombre1 {
    animation: slide-up 1.5s ease-out 0.4s both;
  }

  #nf-wrapper.animar .nf-amp {
    animation: scale-in 1s ease-out 0.6s both;
  }

  #nf-wrapper.animar .nf-nombre2 {
    animation: slide-up 1.5s ease-out 0.8s both;
  }

  /* El marco entra completo... */
  #nf-wrapper.animar .nf-foto-in {
    animation: foto-entrada 1.3s ease-out 0.9s both;
  }

  @keyframes foto-entrada {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* ...y la foto se abre desde el centro hacia arriba y abajo.
     El clip-path va en el óvalo (no en el contenedor) para no recortar
     los anillos dorados ni las joyas, que sobresalen de la caja. */
  #nf-wrapper.animar .nf-foto-ovalo {
    animation: ovalo-abrir 1.7s cubic-bezier(0.2, 0.7, 0.2, 1) 1.1s both;
  }

  @keyframes ovalo-abrir {
    from {
      clip-path: inset(50% 0 50% 0);
    }
    to {
      /* Un pelo negativo: el clip queda por fuera del borde y no puede
         dejar ninguna arista recta a la vista. */
      clip-path: inset(-2px);
    }
  }

  /* Los anillos se asientan alrededor del medallón */
  #nf-wrapper.animar .nf-foto-anillo-ext,
  #nf-wrapper.animar .nf-foto-anillo-int {
    animation: anillo-in 1.5s ease-out 1.5s both;
  }

  @keyframes anillo-in {
    from {
      opacity: 0;
      transform: scale(1.08);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* Resplandor: destella suave al abrirse y queda como halo tenue */
  #nf-wrapper.animar .nf-resplandor {
    animation: resplandor 2.8s ease-out 0.8s both;
  }

  @keyframes resplandor {
    0% {
      opacity: 0;
      transform: translate(-50%, -50%) scale(0.55);
    }
    35% {
      opacity: 1;
    }
    100% {
      opacity: 0.42;
      transform: translate(-50%, -50%) scale(1);
    }
  }

  /* Las guirnaldas se deslizan desde cada costado, ya revelada la foto.
     El translateY va DESPUÉS del rotate, así que empuja cada guirnalda
     hacia afuera sobre el eje horizontal de la pantalla. */
  #nf-wrapper.animar .nf-guirnalda-izq {
    animation: guirnalda-izq 2s cubic-bezier(0.16, 0.84, 0.24, 1) 2.2s both;
  }

  @keyframes guirnalda-izq {
    from {
      opacity: 0;
      transform: translateY(-50%) rotate(90deg) translateY(70px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) rotate(90deg) translateY(0);
    }
  }

  #nf-wrapper.animar .nf-guirnalda-der {
    animation: guirnalda-der 2s cubic-bezier(0.16, 0.84, 0.24, 1) 2.35s both;
  }

  @keyframes guirnalda-der {
    from {
      opacity: 0;
      transform: translateY(-50%) rotate(-90deg) translateY(70px);
    }
    to {
      opacity: 1;
      transform: translateY(-50%) rotate(-90deg) translateY(0);
    }
  }

  /* Las joyas aparecen al final, con un titileo muy leve */
  #nf-wrapper.animar .nf-joya-arriba,
  #nf-wrapper.animar .nf-joya-abajo {
    animation:
      joya-in 0.9s ease-out 2.4s both,
      joya-titileo 4.5s ease-in-out 3.4s infinite;
  }

  @keyframes joya-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes joya-titileo {
    0%,
    100% {
      box-shadow:
        0 0 0 3px rgba(255, 255, 255, 0.9),
        0 0 10px rgba(196, 148, 92, 0.45);
    }
    50% {
      box-shadow:
        0 0 0 3px rgba(255, 255, 255, 0.95),
        0 0 20px rgba(196, 148, 92, 0.85);
    }
  }

  /* Zoom lentísimo: la foto "respira" y no se siente estática */
  #nf-wrapper.animar .nf-foto {
    animation: ken-burns 18s ease-in-out 2.8s infinite alternate;
  }

  @keyframes ken-burns {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.08);
    }
  }

  /* Destello que cruza una sola vez, ya revelada la foto */
  #nf-wrapper.animar .nf-foto-brillo {
    animation: foto-brillo 1.7s ease-out 2.5s 1 both;
  }

  @keyframes foto-brillo {
    0% {
      left: -60%;
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    100% {
      left: 125%;
      opacity: 0;
    }
  }

  #nf-wrapper.animar .nf-player {
    animation: fade-in 1.5s ease-out 1.4s both;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // ANIMACION DE ENTRADA (se repite en cada scroll)
  const initEntradaNombres = () => {
    const seccion = document.getElementById("nf-wrapper");
    if (!seccion) return;

    // Si la portada está en la página, esta sección queda "en espera": su
    // entrada no arranca con el scroll (se dispararía detrás de la portada,
    // y el invitado nunca la vería), sino cuando se abre el sobre.
    const portada = document.getElementById("portada-section");
    let habilitado = !portada;

    const animar = () => seccion.classList.add("animar");

    if (portada) {
      document.addEventListener(
        "invitacion-abierta",
        () => {
          habilitado = true;
          animar();
        },
        { once: true },
      );
    }

    ScrollTrigger.create({
      trigger: "#nf-wrapper",
      start: "top 85%",
      onEnter: () => {
        if (habilitado) animar();
      },
      // Al salir hacia arriba se quita la clase: las animaciones CSS se
      // cancelan y vuelven al estado inicial, listas para repetirse.
      onLeaveBack: () => seccion.classList.remove("animar"),
    });
  };

  document.addEventListener("DOMContentLoaded", initEntradaNombres);
  document.addEventListener("astro:page-load", initEntradaNombres);

  // REPRODUCTOR + BARRA DE PROGRESO
  document.addEventListener("DOMContentLoaded", () => {
    const btnCorazon = document.getElementById("btn-play-corazon");
    const corazonPlay = document.getElementById("corazon-play");
    const barraProgreso = document.getElementById("barra-progreso");
    const progresoFill = document.getElementById("progreso-fill");
    const progresoDot = document.getElementById("progreso-dot");
    const btnPrev = document.getElementById("btn-prev");
    const btnNext = document.getElementById("btn-next");

    // Crea el audio si aún no existe (canción en /public/musica)
    function ensureAudio(): HTMLAudioElement {
      let audio = (window as any).audioGlobal as HTMLAudioElement;
      if (!audio) {
        audio = new Audio("/musica/melodia.mp3");
        audio.loop = true;
        audio.volume = 0.5;
        (window as any).audioGlobal = audio;
      }
      return audio;
    }

    // Solo lee el audio actual (sin crearlo)
    function peekAudio(): HTMLAudioElement | null {
      return (window as any).audioGlobal || null;
    }

    // Play / Pausa (reproduce la canción)
    btnCorazon?.addEventListener("click", () => {
      const audio = ensureAudio();

      if ((window as any).estaReproduciendoGlobal) {
        audio.pause();
        (window as any).estaReproduciendoGlobal = false;
      } else {
        audio.play().catch((e: any) => console.log("Error audio:", e));
        (window as any).estaReproduciendoGlobal = true;
      }
    });

    const corazonPause = document.getElementById("corazon-pause");

    // Muestra el play (pausada) o el ícono de pausa (sonando)
    function actualizarCorazon() {
      if ((window as any).estaReproduciendoGlobal) {
        corazonPlay?.classList.add("hidden");
        corazonPause?.classList.remove("hidden");
      } else {
        corazonPause?.classList.add("hidden");
        corazonPlay?.classList.remove("hidden");
      }
    }

    // Barra de progreso: solo muestra el avance (no se puede mover)
    function loopProgreso() {
      const audio = peekAudio();
      if (audio && audio.duration && !isNaN(audio.duration)) {
        const pct = (audio.currentTime / audio.duration) * 100;
        if (progresoFill) progresoFill.style.width = pct + "%";
        if (progresoDot) progresoDot.style.left = pct + "%";
      }
      actualizarCorazon();
      requestAnimationFrame(loopProgreso);
    }
    requestAnimationFrame(loopProgreso);

    // Anterior: reinicia la canción
    btnPrev?.addEventListener("click", () => {
      const audio = peekAudio();
      if (audio) audio.currentTime = 0;
    });

    // Siguiente: reinicia la canción
    btnNext?.addEventListener("click", () => {
      const audio = peekAudio();
      if (audio) audio.currentTime = 0;
    });
  });
</script>
