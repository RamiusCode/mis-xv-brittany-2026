---
// src/components/Dedicatoria1.astro - Dedicatoria bajo los nombres
---

<section
  class="relative w-full flex justify-center overflow-hidden"
  id="ded1-wrapper"
  style="padding-top: 1.5rem; padding-bottom: 0.75rem;"
>
  <div
    class="relative z-10 w-full max-w-[480px] text-center flex flex-col items-center"
    style="padding-left: 2rem; padding-right: 2rem;"
  >
    <p class="ded1-item ded1-texto">
      “Hoy dejo atrás mi niñez para comenzar una nueva etapa llena de sueños,
      ilusiones y esperanza. Agradezco a Dios y a mi familia por acompañarme en
      este momento tan especial: mis 15 años.”
    </p>
  </div>
</section>

<style>
  /* Dedicatoria: serif normal (sin cursiva) en lila */
  .ded1-texto {
    font-family: "Crimson Text", serif;
    font-style: normal;
    font-weight: 400;
    color: #7f5aa8;
    font-size: clamp(1.25rem, 5.4vw, 1.5rem);
    line-height: 1.45;
    max-width: 330px;
    margin: 0;
    text-wrap: balance;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initDedicatoria1 = () => {
    const items = gsap.utils.toArray(".ded1-item");
    if (!items.length) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll.
    const reset = () => {
      gsap.killTweensOf(items);
      gsap.set(items, { opacity: 0, y: 30 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#ded1-wrapper",
      start: "top 80%",
      onEnter: () => {
        gsap.to(items, {
          opacity: 1,
          y: 0,
          duration: 1,
          stagger: 0.2,
          ease: "power2.out",
        });
      },
      onLeaveBack: reset,
    });
  };

  document.addEventListener("DOMContentLoaded", initDedicatoria1);
  document.addEventListener("astro:page-load", initDedicatoria1);
</script>
