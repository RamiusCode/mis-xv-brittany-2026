---
// src/components/Portada.astro - Portada XV años (rosado acuarela, mobile first)
---

<!-- CAPA BLANCA DE TRANSICIÓN — tapa el fondo del layout durante el fade -->
<div
    id="capa-blanca"
    style="
    position: fixed;
    inset: 0;
    background: #f3eefa;
    z-index: 9999;
    opacity: 1;
    pointer-events: none;
"
>
</div>

<section
    class="fixed inset-0 w-full flex justify-center z-[10000] overflow-hidden"
    id="portada-section"
    style="background-color: #e6def2;"
>
    <!-- Columna de la invitación: el fondo y las flores se alinean a este ancho -->
    <div class="relative w-full max-w-[480px] h-full overflow-hidden">
        <!-- ── FONDO ───────────────────────────────────────────
             Se ajusta al ANCHO completo y se ESTIRA en vertical
             (object-fit: fill) para celulares largos o cortos. -->
        <img
            id="portada-fondo"
            src="/imagenes/fondo.png"
            alt=""
            class="absolute inset-0 w-full h-full pointer-events-none select-none z-[1]"
            style="object-fit: fill; object-position: center;"
        />

        <!-- ── FLORES DECORATIVAS ─────────────────────────────── -->
        <!-- Flor superior izquierda (orientación original) -->
        <img
            src="/imagenes/flor.png"
            alt=""
            id="flor-arriba-izq"
            class="absolute top-0 left-0 pointer-events-none z-[6] select-none"
            style="width: 58%; max-width: 270px; height: auto;"
        />

        <!-- Flor inferior derecha (la misma flor girada 180°) -->
        <img
            src="/imagenes/flor.png"
            alt=""
            id="flor-abajo-der"
            class="absolute bottom-0 right-0 pointer-events-none z-[6] select-none"
            style="width: 58%; max-width: 270px; height: auto; transform: rotate(180deg);"
        />

        <!-- ── CONTENIDO PRINCIPAL ────────────────────────────── -->
        <div
            class="absolute inset-0 z-10 flex flex-col items-center justify-center text-center"
            style="padding-left: 1.75rem; padding-right: 1.75rem;"
        >
            <!-- MIS -->
            <p id="titulo-mis" class="portada-mis">MIS</p>

            <!-- 15 años -->
            <h1 id="titulo" class="portada-titulo">
                <span class="portada-num">15</span>
                <span class="portada-anios">años</span>
            </h1>

            <!-- Adorno bajo el título -->
            <div id="adorno" class="portada-adorno">
                <span class="portada-adorno-linea"></span>
                <span class="portada-adorno-punto"></span>
                <span class="portada-adorno-linea"></span>
            </div>

            <!-- Sobre -->
            <div id="sobre-container" class="portada-sobre cursor-pointer">
                <img
                    src="/imagenes/sobre.png"
                    alt="Sobre de invitación"
                    class="w-full h-auto select-none"
                    style="filter: drop-shadow(0 14px 22px rgba(110, 80, 160, 0.28));"
                />
            </div>

            <!-- Instrucción -->
            <p id="instruccion" class="portada-instruccion">
                TOCA EL SOBRE Y ABRE<br />TU INVITACION
            </p>
        </div>
    </div>
</section>

<style>
    body.portada-activa {
        overflow: hidden !important;
        height: 100vh !important;
    }

    /* La capa blanca tapa el fondo del layout siempre */
    #capa-blanca {
        transition: opacity 0.4s ease;
    }

    /* Alto real del dispositivo (barras del navegador incluidas) */
    #portada-section {
        height: 100vh;
        height: 100dvh;
    }

    /* ── MIS ─────────────────────────────────────────── */
    .portada-mis {
        font-family: "Crimson Text", serif;
        color: #8a63b0;
        font-size: clamp(1.3rem, 6.4vw, 1.9rem);
        letter-spacing: 0.38em;
        text-indent: 0.38em;
        line-height: 1;
        margin: 0;
    }

    /* ── 15 años ─────────────────────────────────────── */
    .portada-titulo {
        font-family: "Great Vibes", cursive;
        line-height: 1.2;
        margin: 0;
        margin-top: clamp(0.4rem, 1.5vh, 0.9rem);
        /* El degradado se recorta con background-clip: text, así que la caja
           necesita aire extra o los rasgos de la cursiva salen y se "cortan". */
        padding: 0.1em 0.15em 0.22em;
        white-space: nowrap;
        background: linear-gradient(
            100deg,
            #c9b3e2 0%,
            #a184c9 22%,
            #7b4fa8 45%,
            #a98cc9 62%,
            #7b4fa8 82%,
            #cbb8e4 100%
        );
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
        filter: drop-shadow(0 2px 4px rgba(110, 75, 150, 0.18));
    }

    .portada-num {
        font-size: clamp(3.6rem, 21vw, 6.2rem);
    }

    .portada-anios {
        font-size: clamp(2.8rem, 16vw, 4.8rem);
        margin-left: 0.14em;
    }

    /* ── Adorno ──────────────────────────────────────── */
    .portada-adorno {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        margin-top: clamp(0.2rem, 1vh, 0.6rem);
    }

    .portada-adorno-linea {
        display: block;
        width: clamp(18px, 7vw, 30px);
        height: 1px;
        background: linear-gradient(
            to right,
            rgba(196, 148, 92, 0),
            #c4945c,
            rgba(196, 148, 92, 0)
        );
    }

    .portada-adorno-punto {
        display: block;
        width: 6px;
        height: 6px;
        background: #c4945c;
        border-radius: 9999px;
        transform: rotate(45deg);
        border-radius: 1px;
    }

    /* ── Sobre ───────────────────────────────────────── */
    .portada-sobre {
        width: 80%;
        max-width: 380px;
        min-width: 225px;
        margin-top: clamp(1.2rem, 4.5vh, 2.4rem);
    }

    /* ── Instrucción ─────────────────────────────────── */
    .portada-instruccion {
        font-family: "Crimson Text", serif;
        color: #8a63b0;
        font-size: clamp(0.82rem, 4vw, 1.08rem);
        letter-spacing: 0.14em;
        line-height: 1.7;
        margin: 0;
        margin-top: clamp(1.3rem, 5vh, 2.6rem);
        max-width: 320px;
    }
</style>

<script>
    import { gsap } from "gsap";

    if (typeof window !== "undefined") {
        document.addEventListener("DOMContentLoaded", () => {
            document.body.classList.add("portada-activa");

            // ── Estado inicial ──────────────────────────────────────
            gsap.set("#flor-arriba-izq", { opacity: 0, x: -40, y: -40 });
            // La flor de abajo va girada 180° (misma imagen que arriba)
            gsap.set("#flor-abajo-der", {
                opacity: 0,
                x: 40,
                y: 40,
                rotation: 180,
            });
            gsap.set("#titulo-mis", { opacity: 0, y: -20 });
            gsap.set("#titulo", { opacity: 0, y: -30, scale: 0.95 });
            gsap.set("#adorno", { opacity: 0, scaleX: 0.4 });
            gsap.set("#sobre-container", { opacity: 0, y: 30, scale: 0.9 });
            gsap.set("#instruccion", { opacity: 0 });

            // ── Animaciones de entrada ──────────────────────────────
            const tl = gsap.timeline({ delay: 0.3 });

            // Todo entra a la vez: cada tween arranca en la posición 0
            // de la timeline, sin escalonado.
            tl.to(
                "#flor-arriba-izq",
                { opacity: 1, x: 0, y: 0, duration: 1.2, ease: "power2.out" },
                0,
            )
                .to(
                    "#flor-abajo-der",
                    {
                        opacity: 1,
                        x: 0,
                        y: 0,
                        rotation: 180,
                        duration: 1.2,
                        ease: "power2.out",
                    },
                    0,
                )
                .to(
                    "#titulo-mis",
                    { opacity: 1, y: 0, duration: 1.2, ease: "power2.out" },
                    0,
                )
                .to(
                    "#titulo",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "power2.out",
                    },
                    0,
                )
                .to(
                    "#adorno",
                    { opacity: 1, scaleX: 1, duration: 1.2, ease: "power2.out" },
                    0,
                )
                .to(
                    "#sobre-container",
                    {
                        opacity: 1,
                        y: 0,
                        scale: 1,
                        duration: 1.2,
                        ease: "power2.out",
                    },
                    0,
                )
                .to(
                    "#instruccion",
                    { opacity: 1, duration: 1.2, ease: "power2.out" },
                    0,
                );

            // ── Movimientos naturales de las flores ─────────────────
            tl.add(() => {
                gsap.to("#flor-arriba-izq", {
                    y: -4,
                    rotation: -2,
                    duration: 5,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
                gsap.to("#flor-abajo-der", {
                    y: 4,
                    rotation: 182,
                    duration: 6,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            }, 1.2);

            // ── Latido suave del sobre para invitar al toque ────────
            tl.add(() => {
                gsap.to("#sobre-container", {
                    scale: 1.04,
                    duration: 1.4,
                    repeat: -1,
                    yoyo: true,
                    ease: "sine.inOut",
                });
            }, 1.3);

            // ── Hover en el sobre ───────────────────────────────────
            const sobreContainer = document.getElementById("sobre-container");

            sobreContainer?.addEventListener("mouseenter", () => {
                gsap.to("#sobre-container", {
                    y: -10,
                    scale: 1.08,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });
            sobreContainer?.addEventListener("mouseleave", () => {
                gsap.to("#sobre-container", {
                    y: 0,
                    scale: 1,
                    duration: 0.3,
                    ease: "power2.out",
                });
            });

            // ── Click en el sobre ───────────────────────────────────
            const portadaSection = document.getElementById("portada-section");
            const capaBlanca = document.getElementById("capa-blanca");

            sobreContainer?.addEventListener("click", () => {
                gsap.killTweensOf("#flor-arriba-izq");
                gsap.killTweensOf("#flor-abajo-der");
                gsap.killTweensOf("#sobre-container");

                const tlSalida = gsap.timeline();

                tlSalida
                    .to("#sobre-container", {
                        scale: 1.1,
                        duration: 0.2,
                        ease: "power2.in",
                    })
                    .to(
                        ["#instruccion", "#adorno", "#titulo", "#titulo-mis"],
                        {
                            opacity: 0,
                            y: -20,
                            duration: 0.4,
                            stagger: 0.05,
                            ease: "power2.in",
                        },
                        0.1,
                    )
                    .to(
                        ["#flor-arriba-izq", "#flor-abajo-der"],
                        {
                            opacity: 0,
                            scale: 0.8,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0.1,
                    )
                    .to(
                        "#sobre-container",
                        {
                            opacity: 0,
                            scale: 1.3,
                            duration: 0.4,
                            ease: "power2.in",
                        },
                        0.3,
                    )
                    .to(
                        portadaSection,
                        {
                            opacity: 0,
                            duration: 0.5,
                            ease: "power2.in",
                            onStart: () => {
                                document.body.classList.remove(
                                    "portada-activa",
                                );
                                document.body.style.overflow = "auto";
                                // Avisa al resto de la invitación que el sobre
                                // ya se abrió, para que arranquen sus entradas.
                                document.dispatchEvent(
                                    new CustomEvent("invitacion-abierta"),
                                );
                            },
                            onComplete: () => {
                                portadaSection?.remove();
                                gsap.to(capaBlanca, {
                                    opacity: 0,
                                    duration: 0.4,
                                    ease: "power2.out",
                                    onComplete: () => capaBlanca?.remove(),
                                });
                                window.scrollTo({ top: 0, behavior: "smooth" });
                            },
                        },
                        0.5,
                    );
            });
        });
    }
</script>
