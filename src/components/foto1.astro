---
// src/components/foto1.astro - Foto papel rasgado (solo arriba y abajo)
---

<section
  class="relative w-full flex justify-center"
  id="foto1-wrapper"
  style="padding-top: 0.25rem; padding-bottom: 1rem;"
>
  <div class="foto1-item w-full max-w-[500px]">
    <svg
      viewBox="0 0 400 600"
      class="foto1-svg w-full h-auto"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <!-- Rasgado grande e irregular (solo afecta arriba/abajo visible) -->
        <filter id="rasgado-foto" x="-30%" y="-40%" width="160%" height="180%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.012"
            numOctaves="4"
            seed="11"
            result="n"
          ></feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            in2="n"
            scale="65"
            xChannelSelector="R"
            yChannelSelector="G"
          ></feDisplacementMap>
        </filter>

        <!-- Máscara: rect ancho (lados rectos) con arriba/abajo rasgados -->
        <mask id="mascara-rasgada">
          <rect
            x="-80"
            y="45"
            width="560"
            height="510"
            fill="white"
            filter="url(#rasgado-foto)"></rect>
        </mask>
      </defs>

      <!-- Foto de borde a borde, rasgada arriba y abajo -->
      <image
        href="/imagenes/foto1.webp"
        x="0"
        y="0"
        width="400"
        height="600"
        preserveAspectRatio="xMidYMid slice"
        mask="url(#mascara-rasgada)"></image>
    </svg>
  </div>
</section>

<style>
  .foto1-svg {
    overflow: visible;
    display: block;
  }
</style>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initFoto1 = () => {
    const item = document.querySelector(".foto1-item");
    if (!item) return;

    // Estado inicial. Se vuelve a aplicar al salir hacia arriba para que
    // la animación de entrada se repita en cada scroll.
    const reset = () => {
      gsap.killTweensOf(".foto1-item");
      gsap.set(".foto1-item", { opacity: 0, y: 30 });
    };

    reset();

    ScrollTrigger.create({
      trigger: "#foto1-wrapper",
      start: "top 82%",
      onEnter: () => {
        gsap.to(".foto1-item", {
          opacity: 1,
          y: 0,
          duration: 1.2,
          ease: "power2.out",
        });
      },
      onLeaveBack: reset,
    });
  };

  document.addEventListener("DOMContentLoaded", initFoto1);
  document.addEventListener("astro:page-load", initFoto1);
</script>
