---
// src/components/GaleriaFotos.astro - Galería con transición (papel rasgado)
const fotos = [
  "foto4",
  "foto5",
  "foto6",
  "foto7",
  "foto8",
  "foto9",
  "foto10",
  "foto11",
  "foto12",
].map((f) => `/imagenes/${f}.webp`);
---

<section
  class="relative w-full flex flex-col items-center"
  id="gal-wrapper"
  style="padding-top: 1rem; padding-bottom: 2rem;"
>
  <!-- Título -->
  <p
    class="gal-item font-mention italic text-[#3A4A35] text-4xl md:text-5xl mb-6"
  >
    Nuestra Galería
  </p>

  <!-- Slideshow papel rasgado -->
  <div class="gal-item w-full max-w-[500px]">
    <svg
      viewBox="0 0 400 600"
      class="gal-svg w-full h-auto"
      xmlns="http://www.w3.org/2000/svg"
    >
      <defs>
        <filter id="rasgado-gal" x="-30%" y="-40%" width="160%" height="180%">
          <feTurbulence
            type="fractalNoise"
            baseFrequency="0.012"
            numOctaves="4"
            seed="11"
            result="n"
          ></feTurbulence>
          <feDisplacementMap
            in="SourceGraphic"
            in2="n"
            scale="65"
            xChannelSelector="R"
            yChannelSelector="G"
          ></feDisplacementMap>
        </filter>
        <mask id="mascara-gal">
          <rect
            x="-80"
            y="45"
            width="560"
            height="510"
            fill="white"
            filter="url(#rasgado-gal)"></rect>
        </mask>
      </defs>

      <g mask="url(#mascara-gal)">
        {
          fotos.map((src, i) => (
            <image
              class="gal-slide"
              href={src}
              x="0"
              y="0"
              width="400"
              height="600"
              preserveAspectRatio="xMidYMid slice"
              opacity={i === 0 ? "1" : "0"}
            />
          ))
        }
      </g>
    </svg>
  </div>

  <!-- Botón ver todas -->
  <button
    id="gal-abrir"
    class="gal-item bg-transparent text-[#3A4A35] border border-[#3A4A35] font-wiretype text-sm tracking-[0.2em] uppercase rounded-full shadow-sm transition-all duration-300 hover:bg-[#3A4A35] hover:text-[#EDF0E6] hover:shadow-lg hover:-translate-y-0.5"
    style="padding: 0.6rem 2rem; margin-top: 1.5rem;"
  >
    Ver todas las fotos
  </button>
</section>

<!-- Modal galería completa -->
<div
  id="gal-modal"
  class="fixed inset-0 z-[10000] items-center justify-center p-4"
  style="display: none; background: rgba(28, 36, 25, 0.92); backdrop-filter: blur(6px);"
>
  <button
    id="gal-cerrar"
    class="absolute top-4 right-5 text-white text-3xl leading-none font-light z-10"
    aria-label="Cerrar"
  >
    &times;
  </button>

  <p
    class="absolute top-5 left-1/2 -translate-x-1/2 font-mention italic text-white text-3xl"
  >
    Galería
  </p>

  <div
    class="w-full max-w-[520px] max-h-[80vh] overflow-y-auto grid grid-cols-2 gap-2 mt-16"
  >
    {
      fotos.map((src) => (
        <img
          src={src}
          alt="Foto de la boda"
          loading="lazy"
          class="w-full h-44 sm:h-52 object-cover rounded-lg shadow-md"
        />
      ))
    }
  </div>
</div>

<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const initGaleria = () => {
    // ── Animación de entrada ──
    const items = gsap.utils.toArray(".gal-item");
    if (items.length) {
      gsap.set(items, { opacity: 0, y: 30 });
      ScrollTrigger.create({
        trigger: "#gal-wrapper",
        start: "top 82%",
        once: true,
        onEnter: () => {
          gsap.to(items, {
            opacity: 1,
            y: 0,
            duration: 1,
            stagger: 0.15,
            ease: "power2.out",
          });
        },
      });
    }

    // ── Slideshow con crossfade ──
    const slides = Array.from(document.querySelectorAll(".gal-slide"));
    if (slides.length > 1) {
      let idx = 0;
      setInterval(() => {
        idx = (idx + 1) % slides.length;
        slides.forEach((s, i) => {
          gsap.to(s, {
            attr: { opacity: i === idx ? 1 : 0 },
            duration: 1.3,
            ease: "power1.inOut",
          });
        });
      }, 4000);
    }

    // ── Modal ──
    const modal = document.getElementById("gal-modal");
    const abrir = document.getElementById("gal-abrir");
    const cerrar = document.getElementById("gal-cerrar");

    abrir?.addEventListener("click", () => {
      if (!modal) return;
      modal.style.display = "flex";
      document.body.style.overflow = "hidden";
      gsap.fromTo(
        modal,
        { opacity: 0 },
        { opacity: 1, duration: 0.4, ease: "power2.out" },
      );
    });

    const cerrarModal = () => {
      if (!modal) return;
      gsap.to(modal, {
        opacity: 0,
        duration: 0.3,
        ease: "power2.in",
        onComplete: () => {
          modal.style.display = "none";
          document.body.style.overflow = "";
        },
      });
    };

    cerrar?.addEventListener("click", cerrarModal);
    modal?.addEventListener("click", (e) => {
      if (e.target === modal) cerrarModal();
    });
  };

  document.addEventListener("DOMContentLoaded", initGaleria);
  document.addEventListener("astro:page-load", initGaleria);
</script>
